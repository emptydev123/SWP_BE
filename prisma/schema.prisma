generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String              @id @default(uuid())
  email                String              @unique
  passwordHash         String?             @map("password_hash")
  fullName             String?             @map("full_name")
  studentCode          String?             @unique @map("student_code")
  phone                String?
  avatarUrl            String?             @map("avatar_url")
  isActive             Boolean             @default(true) @map("is_active")
  emailVerified        Boolean             @default(false) @map("email_verified")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  auth_role            SystemRole          @default(USER)
  isLeader             Boolean?            @map("is_leader")
  staffCheckins        Checkin[]
  reviewedApplications ClubApplication[]   @relation("ReviewedBy")
  applications         ClubApplication[]   @relation("ApplicantUser")
  assignedMemberships  ClubMembership[]    @relation("AssignedBy")
  memberships          ClubMembership[]    @relation("MemberUser")
  createdClubs         Club[]              @relation("ClubCreator")
  ledClubs             Club[]              @relation("ClubLeader")
  eventRegistrations   EventRegistration[]
  eventStaff           EventStaff[]
  createdEvents        Event[]             @relation("EventCreator")
  feedbacks            Feedback[]
  approvedFundRequests FundRequest[]       @relation("FundRequestApprover")
  createdFundRequests  FundRequest[]       @relation("FundRequestCreator")
  approvedEvents       Event[]             @relation("EventApprovalUser")
  tickets              Ticket[]
  transactions         Transaction[]

  @@map("users")
}

model Club {
  id                   String              @id @default(uuid())
  name                 String              @unique
  slug                 String?             @unique
  description          String?
  logoUrl              String?             @map("logo_url")
  coverUrl             String?             @map("cover_url")
  membershipFeeEnabled Boolean             @default(false) @map("membership_fee_enabled")
  membershipFeeAmount  Int                 @default(0) @map("membership_fee_amount")
  isActive             Boolean             @default(true) @map("is_active")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  leaderUserId         String              @map("leader_user_id")
  createdById          String?             @map("created_by")
  applications         ClubApplication[]
  ledger               ClubLedger[]
  memberships          ClubMembership[]
  socialLinks          ClubSocialLink[]
  createdBy            User?               @relation("ClubCreator", fields: [createdById], references: [id])
  leader               User                @relation("ClubLeader", fields: [leaderUserId], references: [id])
  eventRegistrations   EventRegistration[]
  events               Event[]
  fundRequests         FundRequest[]
  transactions         Transaction[]

  @@map("clubs")
}

model ClubSocialLink {
  id        String   @id @default(uuid())
  clubId    String   @map("club_id")
  platform  String?
  url       String?
  createdAt DateTime @default(now()) @map("created_at")
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@map("club_social_links")
}

model ClubMembership {
  id           String           @id @default(uuid())
  clubId       String           @map("club_id")
  userId       String           @map("user_id")
  role         MembershipRole   @default(MEMBER)
  status       MembershipStatus @default(ACTIVE)
  joinedAt     DateTime?        @map("joined_at")
  activatedAt  DateTime?        @map("activated_at")
  expiresAt    DateTime?        @map("expires_at")
  assignedById String?          @map("assigned_by")
  notes        String?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  assignedBy   User?            @relation("AssignedBy", fields: [assignedById], references: [id])
  club         Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user         User             @relation("MemberUser", fields: [userId], references: [id])
  transactions Transaction[]    @relation("MembershipTransaction")

  @@unique([clubId, userId])
  @@map("club_memberships")
}

model ClubApplication {
  id           String            @id @default(uuid())
  clubId       String            @map("club_id")
  userId       String            @map("user_id")
  introduction String?
  status       ApplicationStatus @default(PENDING)
  reviewedById String?           @map("reviewed_by")
  reviewNotes  String?           @map("review_notes")
  createdAt    DateTime          @default(now()) @map("created_at")
  reviewedAt   DateTime?         @map("reviewed_at")
  club         Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  reviewedBy   User?             @relation("ReviewedBy", fields: [reviewedById], references: [id])
  user         User              @relation("ApplicantUser", fields: [userId], references: [id])

  @@unique([clubId, userId, status])
  @@map("club_applications")
}

model Event {
  id            String              @id @default(uuid())
  clubId        String              @map("club_id")
  createdById   String?             @map("created_by")
  approvalById  String?             @map("approval_by")
  title         String
  description   String?
  type          EventType           @default(PUBLIC)
  pricingType   PricingType?        @map("pricing_type")
  price         Int                 @default(0)
  capacity      Int?
  visibleFrom   DateTime?           @map("visible_from")
  startTime     DateTime?           @map("start_time")
  endTime       DateTime?           @map("end_time")
  location      String?
  isActive      Boolean             @default(true) @map("is_active")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  format        EventFormat         @default(OFFLINE)
  onlineLink    String?             @map("online_link")
  approvalAt    DateTime?           @map("approval_at")
  approvalStatus EventApprovalStatus @default(PENDING) @map("approval_status")
  checkins      Checkin[]
  registrations EventRegistration[]
  staff         EventStaff[]
  club          Club                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy     User?               @relation("EventCreator", fields: [createdById], references: [id])
  approvalBy    User?               @relation("EventApprovalUser", fields: [approvalById], references: [id])
  feedbacks     Feedback[]
  fundRequests  FundRequest[]
  tickets       Ticket[]

  @@map("events")
}

model Ticket {
  id                 String             @id @default(uuid())
  eventId            String             @map("event_id")
  userId             String?            @map("user_id")
  ticketType         String?            @map("ticket_type")
  price              Int                @default(0)
  transactionId      String?            @map("transaction_id")
  qrCode             String?            @unique @map("qr_code")
  status             TicketStatus       @default(INIT)
  purchasedAt        DateTime?          @map("purchased_at")
  assignedAt         DateTime?          @map("assigned_at")
  usedAt             DateTime?          @map("used_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  onlineLink         String?            @map("online_link")
  holderName         String?            @map("holder_name")
  holderEmail        String?            @map("holder_email")
  holderPhone        String?            @map("holder_phone")
  checkins           Checkin[]
  registration       EventRegistration? @relation("EventRegistrationTicket")
  event              Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  transaction        Transaction?       @relation(fields: [transactionId], references: [id])
  user               User?              @relation(fields: [userId], references: [id])
  ticketTransactions Transaction[]      @relation("TicketTransaction")

  @@map("tickets")
}

model Transaction {
  id                    String            @id @default(uuid())
  clubId                String?           @map("club_id")
  userId                String?           @map("user_id")
  type                  TransactionType
  referenceMembershipId String?           @map("reference_membership_id")
  referenceTicketId     String?           @map("reference_ticket_id")
  amount                Int
  currency              String            @default("VND")
  paymentMethod         String?           @map("payment_method")
  paymentReference      String?           @unique @map("payment_reference")
  status                TransactionStatus @default(PENDING)
  payosPayload          String?           @map("payos_payload")
  createdAt             DateTime          @default(now()) @map("created_at")
  confirmedAt           DateTime?         @map("confirmed_at")
  time_out              DateTime?         @db.Timestamptz(6)
  qr_code               String?
  ledger                ClubLedger[]
  tickets               Ticket[]
  club                  Club?             @relation(fields: [clubId], references: [id])
  referenceMembership   ClubMembership?   @relation("MembershipTransaction", fields: [referenceMembershipId], references: [id])
  referenceTicket       Ticket?           @relation("TicketTransaction", fields: [referenceTicketId], references: [id])
  user                  User?             @relation(fields: [userId], references: [id])

  @@map("transactions")
}

model FundRequest {
  id            String            @id @default(uuid())
  clubId        String            @map("club_id")
  eventId       String?           @map("event_id")
  createdById   String?           @map("created_by")
  approvedById  String?           @map("approved_by")
  title         String
  description   String?
  amount        Int
  proofImageUrl String?           @map("proof_image_url")
  status        FundRequestStatus @default(PENDING)
  rejectReason  String?           @map("reject_reason")
  createdAt     DateTime          @default(now()) @map("created_at")
  reviewedAt    DateTime?         @map("reviewed_at")
  disbursedAt   DateTime?         @map("disbursed_at")
  ledger        ClubLedger[]
  items         FundRequestItem[]
  approvedBy    User?             @relation("FundRequestApprover", fields: [approvedById], references: [id])
  club          Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy     User?             @relation("FundRequestCreator", fields: [createdById], references: [id])
  event         Event?            @relation(fields: [eventId], references: [id])

  @@map("fund_requests")
}

model FundRequestItem {
  id            String      @id @default(uuid())
  fundRequestId String      @map("fund_request_id")
  name          String
  description   String?
  amount        Int
  createdAt     DateTime    @default(now()) @map("created_at")
  fundRequest   FundRequest @relation(fields: [fundRequestId], references: [id], onDelete: Cascade)

  @@map("fund_request_items")
}

model ClubLedger {
  id            String       @id @default(uuid())
  clubId        String       @map("club_id")
  type          LedgerType
  transactionId String?      @map("transaction_id")
  fundRequestId String?      @map("fund_request_id")
  amount        Int
  balanceAfter  Int          @map("balance_after")
  note          String?
  createdAt     DateTime     @default(now()) @map("created_at")
  club          Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  fundRequest   FundRequest? @relation(fields: [fundRequestId], references: [id])
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  @@map("club_ledger")
}

model Checkin {
  id           String   @id @default(uuid())
  ticketId     String   @map("ticket_id")
  eventId      String?  @map("event_id")
  staffUserId  String?  @map("staff_user_id")
  scannedAt    DateTime @default(now()) @map("scanned_at")
  locationMeta String?  @map("location_meta")
  createdAt    DateTime @default(now()) @map("created_at")
  event        Event?   @relation(fields: [eventId], references: [id])
  staff        User?    @relation(fields: [staffUserId], references: [id])
  ticket       Ticket   @relation(fields: [ticketId], references: [id])

  @@map("checkins")
}

model EventRegistration {
  id            String    @id @default(uuid())
  eventId       String    @map("event_id")
  clubId        String    @map("club_id")
  userId        String    @map("user_id")
  ticketId      String?   @unique @map("ticket_id")
  registeredAt  DateTime  @default(now()) @map("registered_at")
  checkedInAt   DateTime? @map("checked_in_at")
  checkinMethod String?   @map("checkin_method")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  club          Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticket        Ticket?   @relation("EventRegistrationTicket", fields: [ticketId], references: [id])
  user          User      @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@map("event_registrations")
}

model EventStaff {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_staff")
}

model Feedback {
  id        String   @id @default(uuid())
  eventId   String?  @map("event_id")
  userId    String?  @map("user_id")
  rating    Int?
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@map("feedbacks")
}

model fund_request_items {
  id              String      @id
  fund_request_id String
  name            String
  description     String?
  amount          Int
  created_at      DateTime    @default(now())
  fund_requests   FundRequest @relation(fields: [fund_request_id], references: [id], onDelete: Cascade)
}

enum SystemRole {
  ADMIN
  USER
  MEMBER
}

enum MembershipRole {
  ADMIN
  LEADER
  TREASURER
  STAFF
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  PENDING_PAYMENT
  SUSPENDED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EventType {
  PUBLIC
  INTERNAL
}

enum PricingType {
  FREE
  PAID
  DONATION
}

enum TicketStatus {
  INIT
  RESERVED
  PAID
  CANCELLED
  USED
  EXPIRED
}

enum TransactionType {
  MEMBERSHIP
  EVENT_TICKET
  FUND_REQ
  TOPUP
  REFUND
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum FundRequestStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
  CANCELLED
}

enum LedgerType {
  INCOME
  EXPENSE
}

enum EventFormat {
  ONLINE
  OFFLINE
}

enum EventApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
