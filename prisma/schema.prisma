// Student Club Management System (SCMS) - Prisma Schema
// Version: 3.5
// Project: SWP391 - Group 2

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================
// USERS
// =====================================================

enum SystemRole {
  ADMIN
  USER
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String?  @map("password_hash")
  fullName      String?  @map("full_name")
  studentCode   String?  @unique @map("student_code")
  phone         String?
  avatarUrl     String?  @map("avatar_url")
  role          SystemRole @default(USER) // System Level Role
  isActive      Boolean  @default(true) @map("is_active")
  emailVerified Boolean  @default(false) @map("email_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations - as Leader/Creator
  ledClubs         Club[]   @relation("ClubLeader")
  createdClubs     Club[]   @relation("ClubCreator")

  // Relations - Memberships
  memberships        ClubMembership[] @relation("MemberUser")
  assignedMemberships ClubMembership[] @relation("AssignedBy")

  // Relations - Applications
  applications        ClubApplication[] @relation("ApplicantUser")
  reviewedApplications ClubApplication[] @relation("ReviewedBy")

  // Relations - Events
  createdEvents Event[] @relation("EventCreator")

  // Relations - Tickets & Transactions
  tickets      Ticket[]
  transactions Transaction[]

  // Relations - Fund Requests
  createdFundRequests  FundRequest[] @relation("FundRequestCreator")
  approvedFundRequests FundRequest[] @relation("FundRequestApprover")

  // Relations - Checkins & Feedbacks
  staffCheckins Checkin[]
  feedbacks     Feedback[]

  @@map("users")
}

// =====================================================
// CLUBS
// =====================================================
model Club {
  id                   String   @id @default(uuid())
  name                 String
  slug                 String?  @unique
  description          String?  @db.Text
  logoUrl              String?  @map("logo_url")
  coverUrl             String?  @map("cover_url")
  membershipFeeEnabled Boolean  @default(false) @map("membership_fee_enabled")
  membershipFeeAmount  Int      @default(0) @map("membership_fee_amount")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  // Relations - Leader & Creator
  leaderUserId String @map("leader_user_id")
  leader       User   @relation("ClubLeader", fields: [leaderUserId], references: [id])

  createdById String? @map("created_by")
  createdBy   User?   @relation("ClubCreator", fields: [createdById], references: [id])

  // Relations
  socialLinks  ClubSocialLink[]
  memberships  ClubMembership[]
  applications ClubApplication[]
  events       Event[]
  transactions Transaction[]
  fundRequests FundRequest[]
  ledger       ClubLedger[]

  @@map("clubs")
}

model ClubSocialLink {
  id        String   @id @default(uuid())
  clubId    String   @map("club_id")
  platform  String? // FACEBOOK, INSTAGRAM, DISCORD, etc.
  url       String?
  createdAt DateTime @default(now()) @map("created_at")

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@map("club_social_links")
}

// =====================================================
// CLUB MEMBERSHIPS
// =====================================================
enum MembershipRole {
  ADMIN   // System Admin (Student Union)
  LEADER  // Club President
  TREASURER
  STAFF
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  PENDING_PAYMENT
  SUSPENDED
}

model ClubMembership {
  id          String           @id @default(uuid())
  clubId      String           @map("club_id")
  userId      String           @map("user_id")
  role        MembershipRole   @default(MEMBER)
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime?        @map("joined_at")
  activatedAt DateTime?        @map("activated_at")
  expiresAt   DateTime?        @map("expires_at")
  assignedById String?         @map("assigned_by")
  notes       String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  // Relations
  club       Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user       User  @relation("MemberUser", fields: [userId], references: [id])
  assignedBy User? @relation("AssignedBy", fields: [assignedById], references: [id])

  // Back-reference from Transaction
  transactions Transaction[] @relation("MembershipTransaction")

  @@unique([clubId, userId])
  @@map("club_memberships")
}

// =====================================================
// CLUB APPLICATIONS
// =====================================================
enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ClubApplication {
  id              String            @id @default(uuid())
  clubId          String            @map("club_id")
  userId          String            @map("user_id")
  applicationData String?           @map("application_data") @db.Text
  status          ApplicationStatus @default(PENDING)
  reviewedById    String?           @map("reviewed_by")
  reviewNotes     String?           @map("review_notes") @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  reviewedAt      DateTime?         @map("reviewed_at")

  // Relations
  club       Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user       User  @relation("ApplicantUser", fields: [userId], references: [id])
  reviewedBy User? @relation("ReviewedBy", fields: [reviewedById], references: [id])

  @@unique([clubId, userId, status])
  @@map("club_applications")
}

// =====================================================
// EVENTS
// =====================================================
enum EventType {
  PUBLIC
  INTERNAL
}

enum PricingType {
  FREE
  PAID
  DONATION
}

model Event {
  id          String       @id @default(uuid())
  clubId      String       @map("club_id")
  createdById String?      @map("created_by")
  title       String
  description String?      @db.Text
  type        EventType    @default(PUBLIC)
  pricingType PricingType? @map("pricing_type")
  price       Int          @default(0)
  capacity    Int?
  visibleFrom DateTime?    @map("visible_from")
  startTime   DateTime?    @map("start_time")
  endTime     DateTime?    @map("end_time")
  location    String?
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Relations
  club      Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy User? @relation("EventCreator", fields: [createdById], references: [id])

  tickets      Ticket[]
  fundRequests FundRequest[]
  checkins     Checkin[]
  feedbacks    Feedback[]

  @@map("events")
}

// =====================================================
// TICKETS
// =====================================================
enum TicketStatus {
  INIT
  RESERVED
  PAID
  CANCELLED
  USED
  EXPIRED
}

model Ticket {
  id            String       @id @default(uuid())
  eventId       String       @map("event_id")
  userId        String?      @map("user_id")
  ticketType    String?      @map("ticket_type") // VIP, STANDARD, etc.
  price         Int          @default(0)
  transactionId String?      @map("transaction_id")
  qrCode        String?      @unique @map("qr_code")
  status        TicketStatus @default(INIT)
  purchasedAt   DateTime?    @map("purchased_at")
  assignedAt    DateTime?    @map("assigned_at")
  usedAt        DateTime?    @map("used_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  // Relations
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  checkins Checkin[]

  // Back-reference from Transaction
  ticketTransactions Transaction[] @relation("TicketTransaction")

  @@map("tickets")
}

// =====================================================
// TRANSACTIONS (PayOS Integration)
// =====================================================
enum TransactionType {
  MEMBERSHIP
  EVENT_TICKET
  TOPUP
  REFUND
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

model Transaction {
  id                    String            @id @default(uuid())
  clubId                String?           @map("club_id")
  userId                String?           @map("user_id")
  type                  TransactionType
  referenceMembershipId String?           @map("reference_membership_id")
  referenceTicketId     String?           @map("reference_ticket_id")
  amount                Int
  currency              String            @default("VND")
  paymentMethod         String?           @map("payment_method") // PAYOS, BANK_TRANSFER, CASH
  paymentReference      String?           @unique @map("payment_reference")
  status                TransactionStatus @default(PENDING)
  payosPayload          String?           @map("payos_payload") @db.Text
  createdAt             DateTime          @default(now()) @map("created_at")
  confirmedAt           DateTime?         @map("confirmed_at")

  // Relations
  club                Club?           @relation(fields: [clubId], references: [id])
  user                User?           @relation(fields: [userId], references: [id])
  referenceMembership ClubMembership? @relation("MembershipTransaction", fields: [referenceMembershipId], references: [id])
  referenceTicket     Ticket?         @relation("TicketTransaction", fields: [referenceTicketId], references: [id])

  tickets Ticket[]
  ledger  ClubLedger[]

  @@map("transactions")
}

// =====================================================
// FUND REQUESTS
// =====================================================
enum FundRequestStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
  CANCELLED
}

model FundRequest {
  id            String            @id @default(uuid())
  clubId        String            @map("club_id")
  eventId       String?           @map("event_id")
  createdById   String?           @map("created_by")
  approvedById  String?           @map("approved_by")
  title         String
  description   String?           @db.Text
  amount        Int
  proofImageUrl String?           @map("proof_image_url")
  status        FundRequestStatus @default(PENDING)
  rejectReason  String?           @map("reject_reason") @db.Text
  createdAt     DateTime          @default(now()) @map("created_at")
  reviewedAt    DateTime?         @map("reviewed_at")
  disbursedAt   DateTime?         @map("disbursed_at")

  // Relations
  club       Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  event      Event? @relation(fields: [eventId], references: [id])
  createdBy  User?  @relation("FundRequestCreator", fields: [createdById], references: [id])
  approvedBy User?  @relation("FundRequestApprover", fields: [approvedById], references: [id])

  ledger ClubLedger[]

  @@map("fund_requests")
}

// =====================================================
// CLUB LEDGER (Financial Records)
// =====================================================
enum LedgerType {
  INCOME
  EXPENSE
}

model ClubLedger {
  id            String     @id @default(uuid())
  clubId        String     @map("club_id")
  type          LedgerType
  transactionId String?    @map("transaction_id") // For INCOME
  fundRequestId String?    @map("fund_request_id") // For EXPENSE
  amount        Int
  balanceAfter  Int        @map("balance_after")
  note          String?    @db.Text
  createdAt     DateTime   @default(now()) @map("created_at")

  // Relations
  club        Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id])
  fundRequest FundRequest? @relation(fields: [fundRequestId], references: [id])

  @@map("club_ledger")
}

// =====================================================
// CHECKINS
// =====================================================
model Checkin {
  id           String   @id @default(uuid())
  ticketId     String   @map("ticket_id")
  eventId      String?  @map("event_id")
  staffUserId  String?  @map("staff_user_id")
  scannedAt    DateTime @default(now()) @map("scanned_at")
  locationMeta String?  @map("location_meta") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  ticket Ticket @relation(fields: [ticketId], references: [id])
  event  Event? @relation(fields: [eventId], references: [id])
  staff  User?  @relation(fields: [staffUserId], references: [id])

  @@map("checkins")
}

// =====================================================
// FEEDBACKS
// =====================================================
model Feedback {
  id        String   @id @default(uuid())
  eventId   String?  @map("event_id")
  userId    String?  @map("user_id")
  rating    Int? // 1-5
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id])

  @@map("feedbacks")
}
